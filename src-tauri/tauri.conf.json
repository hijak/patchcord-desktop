{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchcord",
  "version": "0.1.4",
  "identifier": "com.patchcord.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:prod",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Patchcord",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
